# ===================================================
# Admin CMS Authentication
# ===================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=desaPlantungan2026!
AUTH_SECRET=desa-plantungan-secure-secret-token-key-2026

# ===================================================
# PostgreSQL Database Configuration
# ===================================================
# Opsi 1: Menggunakan Single DATABASE_URL (Rekomendasi untuk VPS / Supabase / Neon)
DATABASE_URL=postgres://desa_user:SuperSecretPassword123!@localhost:5432/desa_plantungan_db

# Opsi 2: Menggunakan Parameter Terpisah
PGHOST=localhost
PGPORT=5432
PGDATABASE=desa_plantungan_db
PGUSER=desa_user
PGPASSWORD=SuperSecretPassword123!
PGSSLMODE=disable

# ===================================================
# Cloudflare R2 Object Storage Configuration
# ===================================================
# Dapatkan kredensial ini di Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=desa-plantungan-media
# Custom Domain R2 atau Public R2.dev URL (contoh: https://media.plantungan.desa.id atau https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://pub-your-r2-subdomain.r2.dev
R2_ENDPOINT=
