# Server Configuration
HOST=0.0.0.0
PORT=1337
APP_KEYS=desaplantunganKey1,desaplantunganKey2,desaplantunganKey3,desaplantunganKey4
API_TOKEN_SALT=plantunganApiTokenSalt2025
ADMIN_JWT_SECRET=plantunganAdminSecretKey2025
TRANSFER_TOKEN_SALT=plantunganTransferTokenSalt2025
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
JWT_SECRET=plantunganJwtSecret2025
STRAPI_TELEMETRY_DISABLED=true

# ===================================================
# Cloudflare R2 Object Storage Configuration
# ===================================================
# Dapatkan kredensial ini di Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=desa-plantungan-media
# Custom Domain R2 atau Public R2.dev URL (contoh: https://media.plantungan.desa.id atau https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://pub-your-r2-subdomain.r2.dev
# Optional custom S3 endpoint (default otomatis: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
