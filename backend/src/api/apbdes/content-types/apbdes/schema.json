      "required": true,
      "unique": true
    },
    "pendapatan": {
      "type": "biginteger",
      "required": true
    },
    "belanja": {
      "type": "biginteger",
      "required": true
    },
    "pembiayaan": {
      "type": "biginteger",
      "default": 0
    },
    "rincian_pendapatan": {
      "type": "json"
    },
    "rincian_belanja": {
      "type": "json"
    },
    "file_pdf": {
      "type": "string"
    },
    "keterangan": {
      "type": "text"
    }
  }
}
