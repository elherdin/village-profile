{
  "kind": "collectionType",
  "collectionName": "apbdes_records",
  "info": {
    "singularName": "apbdes",
    "pluralName": "apbdes-records",
    "displayName": "APBDes Transparansi",
    "description": "Laporan Transparansi Anggaran Pendapatan dan Belanja Desa Plantungan"
  },
