{
  "name": "desa-plantungan-monorepo",
  "version": "1.0.0",
  "description": "Website Profil & Sistem Informasi Desa Plantungan (Monorepo Strapi + Angular)",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && ng serve",
    "start:backend": "cd backend && node server.js",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && node server.js",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "desa-plantungan",
    "angular",
    "strapi",
    "headless-cms",
    "monorepo"
  ],
  "author": "Pemerintah Desa Plantungan",
  "license": "MIT",
  "main": "index.js",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
